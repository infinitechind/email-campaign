# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorized redirect URI must be:  <APP_URL>/api/auth/google/callback   e.g. http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of the app (no trailing slash). Required in production / behind a reverse proxy.
# https:// here also turns on Secure cookies.
APP_URL=http://localhost:3000

# MongoDB connection string; the database name comes from the path (default mongodb://127.0.0.1:27017/bulkemail).
MONGODB_URI=mongodb://127.0.0.1:27017/bulkemail
# Optional: override the database name.
# MONGODB_DB=bulkemail
